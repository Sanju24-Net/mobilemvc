@{
    ViewData["Title"] = "Home";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!-- ✅ IMPORTANT -->
    <title>Home</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial;
            background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
            color: white;
            overflow-x: hidden;
        }

        /* HEADER */
        .header {
            text-align: center;
            padding: 30px 20px;
        }

        .header h1 {
            margin: 0;
            font-size: 32px;
        }

        .header p {
            color: #ccc;
        }

        /* PHONE LOGO */
        .logo {
            width: 80px;
            margin-top: 15px;
            transition: 0.4s;
            cursor: pointer;
            max-width: 100%;
            height: auto;
        }

        .logo:hover {
            transform: scale(1.2) rotate(10deg);
            filter: drop-shadow(0 0 15px #00e5ff);
        }

        /* BLINKING MAIN LOGO CARD */
        .main-logo-card {
            width: 300px;
            max-width: 90%;
            margin: 20px auto;
            padding: 25px;
            background: rgba(255,255,255,0.08);
            border-radius: 15px;
            text-align: center;
            backdrop-filter: blur(10px);
            animation: blinkGlow 2s infinite;
        }

        @@keyframes blinkGlow {
            0% { box-shadow: 0 0 5px #00e5ff; }
            50% { box-shadow: 0 0 25px #ff00cc; }
            100% { box-shadow: 0 0 5px #00e5ff; }
        }

        .main-logo-card h3 {
            margin: 10px 0 5px;
        }

        .main-logo-card p {
            color: #ccc;
        }

        /* ACTION BUTTONS */
        .actions {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 30px;
            flex-wrap: wrap;
            padding: 0 10px;
        }

        .btn {
            padding: 12px 20px;
            border-radius: 10px;
            text-decoration: none;
            color: white;
            font-weight: bold;
            transition: 0.3s;
            background: linear-gradient(90deg, #00e5ff, #ff00cc);
            text-align: center;
        }

        .btn:hover {
            transform: scale(1.1);
            box-shadow: 0 0 15px #00e5ff;
        }

        /* FEATURE CARDS */
        .card-container {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 40px;
            flex-wrap: wrap;
            padding: 0 10px 70px;
        }

        .card {
            width: 180px;
            max-width: 90%;
            padding: 20px;
            background: rgba(255,255,255,0.08);
            border-radius: 15px;
            text-align: center;
            transition: 0.3s;
            cursor: pointer;
        }

        .card:hover {
            transform: translateY(-10px) scale(1.05);
            box-shadow: 0 0 20px #ff00cc;
        }

        .card i {
            font-size: 30px;
            margin-bottom: 10px;
        }

        /* 📱 MOBILE RESPONSIVE */
        @@media (max-width: 768px) {

            .header h1 {
                font-size: 22px;
            }

            .header p {
                font-size: 14px;
            }

            .actions {
                flex-direction: column;
                align-items: center;
            }

            .btn {
                width: 80%;
                font-size: 14px;
            }

            .card {
                width: 90%;
            }

            .card-container {
                gap: 15px;
            }
        }

    </style>

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

</head>

<body>

    <!-- HEADER -->
    <div class="header">
        <img class="logo"
             src="https://cdn-icons-png.flaticon.com/512/15/15874.png" />

        <h1>Welcome to Mobile Store</h1>
        <p>Hello @ViewBag.User 👋</p>
    </div>

    <!-- MAIN BLINKING LOGO CARD -->
    <div class="main-logo-card">

        <img class="logo"
             src="https://cdn-icons-png.flaticon.com/512/15/15874.png" />

        <h3> Welcome </h3>
        <p>Administrator</p>

    </div>

    <!-- ACTION BUTTONS -->
    <div class="actions">
        <a class="btn" href="/Products/Index">📱 View Products</a>
        <a class="btn" href="/Account/Logout">🚪 Logout</a>
    </div>

    <!-- FEATURE CARDS -->
    <div class="card-container">

        <div class="card">
            <i class="fa fa-indian-rupee-sign"></i>
            <p>Total Revenue</p>
            <h3>₹ @ViewBag.TotalRevenue</h3>
        </div>

        <a href="/Home/NewProducts" style="text-decoration:none;color:white;">
            <div class="card">
                <i class="fa fa-bag-shopping"></i>
                <p>New Products</p>
                <h3>@ViewBag.NewProductsCount</h3>
            </div>
        </a>

        <div class="card">
            <i class="fa fa-box"></i>
            <p>Total Products</p>
            <h3>@ViewBag.TotalProducts</h3>
        </div>

    </div>

</body>
</html>